{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sweetbites",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-21",
  // Required — without it process.env comes back empty on Workers.
  "compatibility_flags": ["nodejs_compat"],

  // The site is reachable only at sweetbites.pk. The workers.dev and
  // preview URLs served the same pages, which Google reads as a
  // duplicate site competing with the real domain.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // NOTE: once ISR/on-demand revalidation is used (not yet — no page
  // fetches data at this phase), add an R2 bucket bound as
  // NEXT_INC_CACHE_R2_BUCKET. The binding name is hardcoded by
  // @opennextjs/cloudflare; renaming it breaks the cache silently.
}
