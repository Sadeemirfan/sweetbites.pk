# ─────────────────────────────────────────────────────────────────
# BUILD-TIME — inlined into the client bundle by `next build` /
# `opennextjs-cloudflare build`. Must be set wherever the build runs
# (locally and in CI/Cloudflare), not just at request time. Anything
# prefixed NEXT_PUBLIC_ is visible to the browser — never put a
# secret behind that prefix.
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sweetbites.pk
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────
# RUNTIME ONLY — read server-side via process.env, never sent to the
# client. Requires the nodejs_compat flag set in wrangler.jsonc.
#
#   Local (`next dev`)                     → copy this file to .env.local
#   Local (`next preview` / wrangler dev)   → copy this file to .dev.vars
#   Production                              → `wrangler secret put <NAME>`
#                                              or the Cloudflare dashboard
#
# Neither .env.local nor .dev.vars is committed (see .gitignore).
# ─────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
